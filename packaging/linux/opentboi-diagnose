#!/bin/sh
# Collects what is needed to judge how OpenTBOI runs on this machine (a Steam Deck in particular),
# plays the game for a few seconds and writes everything to one text file you can send along.
# Works from a terminal and as a Steam shortcut in Gaming Mode (where there is no terminal): add
# this file as a non-Steam game, start it from Gaming Mode, and read the report afterwards.
#
#   opentboi-diagnose [SECONDS]   run for SECONDS (default 15); the report path is printed
#
# The report holds the system, graphics and controller names and the game's own log. It contains
# no game files. Look it over before posting it: it lists your user name inside paths.
set -u

duration="${1:-15}"
here=$(cd "$(dirname "$0")" && pwd)
game="${here}/opentboi"
[ -x "${game}" ] || game=$(command -v opentboi || true)
report="${HOME}/opentboi-report-$(date +%Y%m%d-%H%M%S).txt"

section() { printf '\n== %s ==\n' "$1"; }
run_if_present() {
    if command -v "$1" > /dev/null 2>&1; then
        "$@" 2>&1 | head -n "${LINES_PER_COMMAND:-40}"
    else
        echo "($1 not installed)"
    fi
}

{
    echo "OpenTBOI diagnostic report, $(date -Is)"
    section "System"
    run_if_present cat /etc/os-release
    uname -a
    run_if_present ldd --version | head -n 1
    echo "session: type=${XDG_SESSION_TYPE:-?} desktop=${XDG_CURRENT_DESKTOP:-?} wayland=${WAYLAND_DISPLAY:-no} x11=${DISPLAY:-no}"
    echo "gamescope: ${GAMESCOPE_WAYLAND_DISPLAY:-not detected}; Steam: ${SteamAppId:-not started from Steam}"
    echo "cpu: $(grep -m 1 'model name' /proc/cpuinfo | cut -d: -f2-); $(grep -c '^processor' /proc/cpuinfo) threads"
    grep -m 1 MemTotal /proc/meminfo

    section "Graphics"
    LINES_PER_COMMAND=25 run_if_present vulkaninfo --summary
    LINES_PER_COMMAND=15 run_if_present glxinfo -B

    section "Controllers (names the kernel sees)"
    grep -A1 '^N: Name=' /proc/bus/input/devices | grep -i 'name=' | grep -iE 'pad|controller|xbox|dualsense|dualshock|pro controller|deck|steam|joy' || echo "(none)"

    section "Game files"
    echo "binary: ${game:-not found}"
    echo "TBOI_GAME_DIR=${TBOI_GAME_DIR:-unset}"
    echo "(the game log below says where it found Isaac)"
    if [ -n "${game}" ]; then
        ldd "${game}" 2>&1 | grep -E 'not found|statically linked' || echo "(every library the binary links is present)"
    fi

    section "Run: ${duration} s, vsync on, SDL logging on"
} > "${report}" 2>&1

if [ -n "${game}" ]; then
    SDL_LOGGING="*=info" "${game}" --showcase --exit-after "${duration}" >> "${report}" 2>&1
    echo "exit code: $?" >> "${report}"
else
    echo "OpenTBOI binary not found next to this script or on PATH." >> "${report}"
fi
echo "Report written to ${report}"
